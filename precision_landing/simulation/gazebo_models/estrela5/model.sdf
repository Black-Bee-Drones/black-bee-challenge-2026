<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="Base_T">
    <static>true</static> <!-- mude para false se o objeto precisar de física/movimento -->

    <link name="link">
      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.1</ixx>
          <iyy>0.1</iyy>
          <izz>0.1</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <visual name="visual">
        <geometry>
          <mesh>
            <uri>meshes/estrela5.glb</uri>
            <!-- se usar .gltf separado, troque para: meshes/modelo.gltf -->
          </mesh>
        </geometry>
        <!-- Não declare <material> aqui: deixe o glTF cuidar do PBR/textura -->
      </visual>

      <collision name="collision">
        <geometry>
          <mesh>
            <uri>meshes/estrela5.glb</uri>
          </mesh>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
