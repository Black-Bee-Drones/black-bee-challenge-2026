                    </geometry>

                </collision>

                <visual name="visual">

                    <geometry>

                        <plane>
                            <normal>0 0 1</normal>
                            <size>100 100</size>
                        </plane>

                    </geometry> -->

                    <!--TEXTURA-->
                    <!-- <material>
                        <ambient>0.2 0.8 0.2 1</ambient>
                        <diffuse>0.2 0.8 0.2 1</diffuse>
                        <specular>0.1 0.1 0.1 1</specular>
                    </material> -->

                    <!-- <material>
                        <pbr>
                            <metal>
                                <albedo_map>textures/grass_texture.png</albedo_map>
                                <roughness>1.0</roughness>
                            </metal>
                        </pbr>
                    </material> -->

                <!-- </visual>

            </link>

        </model> -->

        <!-- ── Obstacle zone (centered around x=15, clear of takeoff) ── -->
        <!-- Shared scenery (gate + obstacle field) — also used by the PX4 world -->
        <include>
          <uri>model://outdoor_field_scenery</uri>
        </include>

        <!-- Iris quadcopter with gimbal (ardupilot_gazebo model) -->
        <include>
          <uri>model://iris_with_gimbal</uri>
          <name>iris</name>
          <pose degrees="true">0 0 0.195 0 0 0</pose>
        </include>

            <!-- RANDOM_BASES -->

            <include>

            <name>base_azul</name>

            <uri>model://base_azul</uri>

            <pose>
                0 0 0.05
                1.5708 0 0
            </pose>

        </include>


    </world>

</sdf>