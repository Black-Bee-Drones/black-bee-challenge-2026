<?xml version="1.0" ?>

<sdf version="1.9">

    <world name="empty_world">

        <physics name="1" type="ignored">
            <max_step_size>0.001</max_step_size>
            <real_time_factor>1</real_time_factor>
        </physics>

        <!-- Fundo -->
        <scene>
            <ambient>0.8 0.8 0.8 1</ambient>
            <background>0.75 0.85 0.95 1</background>
        </scene>


        <!--ILUMINAÇÃO-->

        <light name="sun"
            type="directional">

            <cast_shadows>true</cast_shadows>

            <pose>0 0 10 0 0 0</pose>

            <diffuse>1 1 1 1</diffuse>

            <specular>0.2 0.2 0.2 1</specular>

            <direction>-0.5 0.5 -1</direction>

        </light>

        <!--CHÃO-->

        <model name="ground">

            <static>true</static>

            <link name="ground_link">

                <collision name="collision">

                    <geometry>

                        <plane>
                            <normal>0 0 1</normal>
                            <size>20 20</size>
                        </plane>

                    </geometry>

                </collision>

                <visual name="visual">

                    <geometry>

                        <plane>
                            <normal>0 0 1</normal>
                            <size>100 100</size>
                        </plane>

                    </geometry>

                    <!--TEXTURA-->
                    <material>
                        <ambient>0.2 0.8 0.2 1</ambient>
                        <diffuse>0.2 0.8 0.2 1</diffuse>
                        <specular>0.1 0.1 0.1 1</specular>
                    </material>

                    <!-- <material>
                        <pbr>
                            <metal>
                                <albedo_map>textures/grass_texture.png</albedo_map>
                                <roughness>1.0</roughness>
                            </metal>
                        </pbr>
                    </material> -->

                </visual>

            </link>

        </model>

        <!-- RANDOM_BASES -->

        <include>

            <name>base_azul</name>

            <uri>model://base_azul</uri>

            <pose>
                0 0 0.05
                1.5708 0 0
            </pose>

        </include>


    </world>

</sdf>